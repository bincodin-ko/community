# SQLite for local dev. For Postgres: change provider in prisma/schema.prisma and use
# DATABASE_URL="postgresql://user:pass@host:5432/onda?schema=public"
DATABASE_URL="file:./dev.db"
# Any long random string. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"
# Shown in the UI. Change freely.
NEXT_PUBLIC_APP_NAME="온다"

# ---- Jev (TypeSafe AI System One) — 자동 판정. 없으면 규칙 기반만 동작(fail-open) ----
# 직접: https://console.typesafe.ai (early access)      → TYPESAFE_API_KEY="ts_..."
# 또는 OpenRouter 경유                                  → OPENROUTER_API_KEY="sk-or-..."
# 테스트: node scripts/qa/fake-jev.mjs 를 띄우고        → JEV_BASE_URL="http://127.0.0.1:4141/v1/systemone"
TYPESAFE_API_KEY=""
OPENROUTER_API_KEY=""
JEV_BASE_URL=""
