# SQLite for local dev. For Postgres: change provider in prisma/schema.prisma and use
# DATABASE_URL="postgresql://user:pass@host:5432/onda?schema=public"
DATABASE_URL="file:./dev.db"
# Any long random string. Generate: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"
# Shown in the UI. Change freely.
NEXT_PUBLIC_APP_NAME="온다"

# ---- Jev (TypeSafe AI System One) — 자동 판정. 없으면 규칙 기반만 동작(fail-open) ----
# 직접: https://console.typesafe.ai (early access)      → TYPESAFE_API_KEY="ts_..."
# 또는 OpenRouter 경유                                  → OPENROUTER_API_KEY="sk-or-..."
# 테스트: node scripts/qa/fake-jev.mjs 를 띄우고        → JEV_BASE_URL="http://127.0.0.1:4141/v1/systemone"
TYPESAFE_API_KEY=""
OPENROUTER_API_KEY=""
JEV_BASE_URL=""

# ---- 선택: 허깅페이스 2차 의견 (docs/07) ----
# 자체 서빙: MODEL=<kor_unsmile 계열 모델> uvicorn scripts.ml.unsmile_server:app --port 8787
HF_MODERATION_URL=""
HF_TOKEN=""

# ---- 선택: "비슷한 이야기" 임베딩 서버 (KURE-v1 등). 없으면 문자 바이그램으로 대체 ----
EMBEDDINGS_URL=""
EMBEDDINGS_KEY=""

# 사이트 절대 주소 — sitemap, OG 카드 이미지 주소에 쓰인다
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- 선택: 쿠키 없는 분석. 비워두면 어떤 스크립트도 로드되지 않는다 ----
# Plausible: https://plausible.io/js/script.js  ·  Umami: https://<호스트>/script.js
NEXT_PUBLIC_ANALYTICS_SRC=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
