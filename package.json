{
  "name": "onda-community",
  "version": "0.1.0",
  "private": true,
  "description": "온다(ONDA) — 한국 2030 게이를 위한 텍스트 우선 익명 커뮤니티 MVP",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push && SEED_DEMO=1 SEED_DEMO_PASSWORD=onda-demo-1234 tsx prisma/seed.ts && node scripts/grant-mod.mjs 새벽산책 admin",
    "qa": "node scripts/qa/walk.mjs --base ${QA_BASE:-http://localhost:3000} --out qa-report.md",
    "jev:fake": "node scripts/qa/fake-jev.mjs",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:e2e": "node scripts/qa/e2e.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check",
    "db:seed:demo": "SEED_DEMO=1 SEED_DEMO_PASSWORD=onda-demo-1234 tsx prisma/seed.ts && node scripts/grant-mod.mjs 새벽산책 admin",
    "grant:mod": "node scripts/grant-mod.mjs",
    "cards": "node scripts/growth/render-cards.mjs",
    "digest": "node scripts/growth/digest.mjs",
    "copy:lint": "node scripts/qa/copy-lint.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.11",
    "next": "15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.50.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
